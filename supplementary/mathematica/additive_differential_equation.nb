Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "function"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"epsilon_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"2", "*", 
     RowBox[{"Sinh", "[", "epsilon", "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", "2"}], "*", 
        RowBox[{"epsilon", "^", "2"}]}], "-", 
       RowBox[{"epsilon", "*", "t"}]}], "]"}]}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Plot", " ", "for", " ", "a", " ", "specific", " ", "t", " ", "value"}], 
     ",", 
     RowBox[{"e", ".", "g", "."}], ",", 
     RowBox[{"t", "=", "1"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"epsilon", ",", "100"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"epsilon", ",", "0", ",", "4"}], "}"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<f(\[CurlyEpsilon]) for t = 1\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\[CurlyEpsilon]\>\"", ",", "\"\<f(\[CurlyEpsilon])\>\""}],
        "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotStyle", "->", "Thick"}]}], "]"}], "\n"}]}]], "Input",
